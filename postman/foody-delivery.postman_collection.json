            "url": "{{baseUrl}}/api/orders?page=-1&size=500"
          }
        },
        {
          "name": "Contagem por status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Todos os status, inclusive os com zero', () => pm.expect(body.byStatus).to.have.all.keys('RECEBIDO', 'EM_PREPARO', 'SAIU_PARA_ENTREGA', 'ENTREGUE', 'CANCELADO'));",
                  "pm.test('Total é a soma dos status', () => pm.expect(body.total).to.eql(Object.values(body.byStatus).reduce((a, b) => a + b, 0)));",
                  "pm.test('Conta o pedido entregue', () => pm.expect(body.byStatus.ENTREGUE).to.be.at.least(1));"
                ]
              }
            }
          ],
