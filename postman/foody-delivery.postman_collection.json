              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"status\": \"ENTREGUE\" }"
            },
            "url": "{{baseUrl}}/api/orders/{{orderId}}/status"
          }
        },
        {
          "name": "Cancelar pedido entregue → 422",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 Unprocessable', () => pm.response.to.have.status(422));",
                  "pm.test('Explica a transição', () => pm.expect(pm.response.json().message).to.eql('Transição de ENTREGUE para CANCELADO não permitida'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"status\": \"CANCELADO\" }"
            },
            "url": "{{baseUrl}}/api/orders/{{orderId}}/status"
          }
        },
        {
          "name": "Status desconhecido → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('Lista os valores aceitos', () => pm.expect(body.message).to.include('RECEBIDO, EM_PREPARO, SAIU_PARA_ENTREGA, ENTREGUE, CANCELADO'));",
                  "pm.test('Aponta o campo status', () => pm.expect(body.fieldErrors[0].field).to.eql('status'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{ \"status\": \"PRONTO\" }"
            },
            "url": "{{baseUrl}}/api/orders/{{orderId}}/status"
          }
        },
        {
          "name": "Listar pedidos (primeira página)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Página com metadados', () => {",
                  "  pm.expect(body).to.include.keys('content', 'page', 'size', 'totalElements', 'totalPages');",
                  "  pm.expect(body.page).to.eql(0);",
                  "  pm.expect(body.size).to.eql(20);",
                  "});",
                  "pm.test('Pedido mais recente primeiro, com status atual', () => {",
                  "  pm.expect(body.content[0].id).to.eql(pm.collectionVariables.get('orderId'));",
                  "  pm.expect(body.content[0].status).to.eql('ENTREGUE');",
                  "});",
                  "pm.test('Resposta identificada por X-Request-Id', () => pm.expect(pm.response.headers.get('X-Request-Id')).to.match(/^[0-9a-f-]{8,64}$/));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/orders"
          }
        },
        {
