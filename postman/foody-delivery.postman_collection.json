          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const history = pm.response.json().statusHistory;",
                  "pm.test('Todas as etapas, em ordem', () => pm.expect(history.map(h => h.status)).to.eql(['RECEBIDO', 'EM_PREPARO', 'SAIU_PARA_ENTREGA', 'ENTREGUE']));",
                  "pm.test('Cada etapa com autor e horário', () => history.forEach(h => {",
                  "  pm.expect(h.changedBy.name).to.eql('Operador');",
                  "  pm.expect(h.changedAt).to.be.a('string');",
                  "}));",
                  "pm.test('A transição recusada (422) não entrou no histórico', () => pm.expect(history).to.have.length(4));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
