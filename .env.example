# Copie para .env e ajuste os valores: cp .env.example .env

# Chave HS256 em Base64 (mínimo 32 bytes). Gere com: openssl rand -base64 48
JWT_SECRET=

# Porta pública da aplicação (front-end + /api)
WEB_PORT=80

# Origens liberadas no CORS para acesso direto à API (o front em produção usa a mesma origem e não precisa)
CORS_ALLOWED_ORIGINS=http://localhost:5173
