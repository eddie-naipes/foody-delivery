# Copie para .env e ajuste os valores: cp .env.example .env

# Chave HS256 em Base64 (mínimo 32 bytes). Gere com: openssl rand -base64 48
JWT_SECRET=

# Porta exposta no host
API_PORT=8080

# Origens liberadas no CORS (separadas por vírgula), ex.: https://foody.seudominio.com
CORS_ALLOWED_ORIGINS=http://localhost:5173
